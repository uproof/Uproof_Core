
CRM_STORAGE_BACKEND=supabase

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/[DATABASE]?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/[DATABASE]"

# Shared signing/encryption secret used by admin auth
ADMIN_TOKEN_SECRET=
CRM_DOCS_SECRET=

# Approved superadmin login identity
SUPERADMIN_EMAIL_1=
SUPERADMIN_PASSWORD_1=

SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth (not a Gmail API key; requires an OAuth Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Google Sheets connection for Project 360 and Financials
GOOGLE_SHEETS_API_KEY=

# Project 360
PROJECT_360_SPREADSHEET_ID=
PROJECT_360_OCR_SHEET=OCR
PROJECT_360_OCR_RANGE=OCR!A1:Z200
PROJECT_360_ESTIMATOR_SHEET=Estimator
PROJECT_360_ESTIMATOR_RANGE=Estimator!A1:Z200
PROJECT_360_FILES_SHEET=Projects
PROJECT_360_FILES_RANGE=Projects!A1:Z200

# Financials
FINANCIALS_SPREADSHEET_ID=
FINANCIALS_SHEET_NAME=Financials
FINANCIALS_RANGE=Financials!A1:Z200
