    { "source": "/en/materials/roof-paint", "destination": "/en/materials/jumta-krasa", "permanent": true },
    { "source": "/nl-BE/materials/roof-paint", "destination": "/nl-BE/materials/jumta-krasa", "permanent": true },

    { "source": "/:locale(lv|en|nl-BE)/blog/roof-remonts-riga-cenas", "destination": "/:locale/blog/jumta-remonts-riga-cenas", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/roof-repair-failure", "destination": "/:locale/blog/signs-roof-needs-repair", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/kad-jamaina-yumta-segums", "destination": "/:locale/blog/kad-jamaina-jumta-segums", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/sniega-slog-uz-jumta", "destination": "/:locale/blog/sniega-slogs-uz-jumta", "permanent": true },

