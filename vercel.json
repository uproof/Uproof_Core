{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  
  "headers": [
    {
      "source": "/images/projects/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/lv/admin",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "www.uproof.eu"}],
      "destination": "https://uproof.eu/$1",
      "permanent": true
    },

    { "source": "/ieteikumi", "destination": "/lv/services", "permanent": true },
    { "source": "/services", "destination": "/lv/services", "permanent": true },
    { "source": "/materials", "destination": "/lv/services", "permanent": true },

    { "source": "/:locale(lv|en|nl-BE)/materials", "destination": "/:locale/services", "permanent": true },

    { "source": "/:locale(lv|en|nl-BE)/cenas/:path*", "destination": "/:locale/services", "permanent": true },

    { "source": "/:locale(lv|en|nl-BE)/blog/1", "destination": "/:locale/blog/top-5-roofing-materials-2025", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/2", "destination": "/:locale/blog/how-to-maintain-roof-in-winter", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/3", "destination": "/:locale/blog/signs-roof-needs-repair", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/4", "destination": "/:locale/blog/metal-profile-roofs-guide", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/5", "destination": "/:locale/blog/skylight-installation-pros-cons", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/6", "destination": "/:locale/blog/gutter-system-installation-guide", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/7", "destination": "/:locale/blog/winter-roof-care-snow-ice-tips", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/8", "destination": "/:locale/blog/roof-leak-detection-checklist", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/9", "destination": "/:locale/blog/roof-painting-metal-roof-guide", "permanent": true },
    { "source": "/:locale(lv|en|nl-BE)/blog/10", "destination": "/:locale/blog/jumta-remonts-riga-cenas", "permanent": true },
